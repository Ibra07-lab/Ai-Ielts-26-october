# IELTS Writing API - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# EXAMINER AGENT - Uses Anthropic Claude for precise IELTS evaluation
# =============================================================================
# Valid models: claude-sonnet-4-5-20250929, claude-3-opus-20240229, claude-3-sonnet-20240229
IELTS_WRITING_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# =============================================================================
# TEACHER AGENT - Uses OpenRouter for detailed feedback
# =============================================================================
# Valid models:
# - openai/gpt-4o (recommended: best quality, moderate cost)
# - openai/gpt-4o-mini (good for development: lower cost, good quality)
# - openai/gpt-4-turbo (high quality, higher cost)
# 
# See full list: https://openrouter.ai/models
TEACHER_MODEL=openai/gpt-4o
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=IELTS-AI

# =============================================================================
# FALLBACK - OpenAI API (optional, for explanations agent)
# =============================================================================
OPENAI_API_KEY=sk-proj-your-key-here

# =============================================================================
# NOTES
# =============================================================================
# 1. Get Anthropic API key: https://console.anthropic.com/settings/keys
# 2. Get OpenRouter API key: https://openrouter.ai/keys
# 3. NEVER commit this file with real keys to version control
# 4. Restart the backend after changing these values
