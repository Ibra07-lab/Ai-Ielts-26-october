# === Frontend Environment Variables (Production) ===
# Set these in Vercel Dashboard > Settings > Environment Variables

# Encore Backend URL (deployed on Encore Cloud or Render)
VITE_ENCORE_API_URL=https://your-encore-app.encr.app

# FastAPI Writing Service URL (deployed on Render)
VITE_FASTAPI_WRITING_URL=https://your-writing-api.onrender.com

# FastAPI AI Tutor Service URL (deployed on Render)
VITE_FASTAPI_TUTOR_URL=https://your-tutor-api.onrender.com

# Supabase (already configured in lib/supabase.ts — ensure these match)
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGci...
